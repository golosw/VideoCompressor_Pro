# VideoCompressor Pro Configuration
APP_NAME=VideoCompressor Pro
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE_MB=500

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# AI Service (local LLM - Qwen2.5-Coder 7B)
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b
AI_TIMEOUT=30
